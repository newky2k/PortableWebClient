<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Company>newky2k</Company>
    <Description>Encrypted payload communications classes for the DSoft.Portable.WebClient</Description>
    <PackageTags>Web Client</PackageTags>
    <PackageReleaseNotes>v5.2 - Add .NET 10 Support, removed .NET 8.0</PackageReleaseNotes>
    <DelaySign>false</DelaySign>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
	  <None Include="..\README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
	  </None>
  </ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' == 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
		<PackageReference Include="System.Text.Json" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup Condition=" '$(TargetFramework)' != 'net11.0' ">
		<PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
		<PackageReference Include="System.Text.Json" Version="10.0.12" />
	</ItemGroup>


</Project>
